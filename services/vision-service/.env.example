KAFKA_BOOTSTRAP=localhost:19092
# Leave empty to use the deterministic MOCK analyzer
GEMINI_API_KEY=
# Optional primary model (goes first). Rotation order on 503/429/404/timeouts:
GEMINI_MODEL=
GEMINI_MODELS=gemini-3.7-flash,gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash,gemini-2.5-flash
# AI_TIME_BUDGET_S=60
# AI_CALL_TIMEOUT_S=15
# MODEL_COOLDOWN_S=120
PHOTOS_DIR=/photos
KAFKA_ENABLED=true
KAFKA_GROUP_ID=vision-service
BLUR_THRESHOLD=60
DARK_THRESHOLD=40
MAX_SIDE=1280
