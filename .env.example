# Copy to .env:  cp .env.example .env   (never commit .env)
# All keys are OPTIONAL - the whole stack starts without them:
#  - no ORS_API_KEY    -> routes fall back to a straight line between points
#  - no GEMINI_API_KEY -> vision-service uses a mock analyzer
#  - no JWT_SECRET     -> a random secret is generated at startup (tokens reset on restart)
ORS_API_KEY=
JWT_SECRET=
GEMINI_API_KEY=
# optional
ADMIN_TOKEN=
GEMINI_MODEL=
# comma-separated rotation list (default: gemini-3.7-flash,gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash,gemini-2.5-flash)
GEMINI_MODELS=
KAFKA_ENABLED=true
